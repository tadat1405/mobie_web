# Sao chép thành .env.prod rồi điền giá trị thật. KHÔNG commit file .env.prod.

# Mật khẩu chỉ nên gồm chữ và số (hex) để ghép vào chuỗi kết nối không bị lỗi
# Tạo: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MONGO_USER=aurum
MONGO_PASSWORD=

# Tạo hai chuỗi KHÁC NHAU: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN=
REFRESH_TOKEN=

# PayPal client id (có thể để trống khi thử)
CLINE_ID=

# Origin của web, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost

# Chạy HTTP (chưa có HTTPS) thì đặt false, nếu không cookie đăng nhập không được lưu.
# Có HTTPS thì xoá dòng này hoặc đặt true.
COOKIE_SECURE=false

# Cổng mở ra máy (đổi sang 8080 nếu cổng 80 đang bị chiếm)
HTTP_PORT=80
